# Ambientes Python, caches e arquivos gerados
.venv/
__pycache__/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.py[cod]
*.egg-info/
.coverage
.coverage.*
htmlcov/
build/
dist/

# Binários e pacotes: manter apenas fontes e receitas de empacotamento
*.exe
*.dll
*.zip
*.tar
*.tar.gz
*.tgz
*.7z

# Configurações locais e credenciais (não ignorar templates .example)
.env
.env.*
!.env.example
!.env.*.example
config.json
bootstrap.json
deployment.local.json
deployment.json
!deployment.example.json
!deploy/deployment.example.json
admin.dpapi
*.dpapi
*.key
*.pem
*.pfx
*.p12
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
credentials.json
secrets.json
/deploy/*.known_hosts

# Bancos, logs e estado de execução
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal
*.log
*.log.*
*.lock.tmp
server.lock
maintenance-status.json
/data/
/runtime/
/spool/
/backups/

# Arquivos industriais, inclusive cópias usadas em ensaios
*.[oO][mM][aA]
*.[vV][cC][aA]
*.[sS][dD][fF]
*.[lL][mM][sS]

