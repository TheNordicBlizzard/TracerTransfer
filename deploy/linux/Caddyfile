{
    admin off
    auto_https off
}

(machine_backend) {
    reverse_proxy 127.0.0.1:8765 {
        header_up X-Tracer-Client-IP {header.CF-Connecting-IP}
        header_up -X-Forwarded-For
        header_up -Forwarded
        header_up -CF-Connecting-IP
    }
}

http://:8766 {
    bind 127.0.0.1

    @dashboard {
        method GET
        path /
    }
    @login {
        method POST
        path /api/login
    }
    @logout {
        method POST
        path /api/logout
    }
    @panel_data {
        method GET
        path /api/me /api/status /api/devices /api/activations /api/users
    }
    @panel_mutate {
        method POST
        path /api/devices /api/activations /api/users
    }
    @panel_delete {
        method DELETE
        path_regexp panel_del "^/api/(devices|activations|users)/[A-Za-z0-9_.-]+$"
    }

    @health {
        method GET
        path /health
    }
    @activation {
        method POST
        path /api/activate
    }
    @heartbeat {
        method POST
        path /api/heartbeat
    }
    @upload {
        method PUT
        path_regexp upload "^/api/files/[A-Za-z0-9][A-Za-z0-9_. -]{0,119}$"
    }
    @status {
        method GET
        path_regexp status "^/api/files/status/[a-f0-9]{32}$"
    }
    @lease {
        method POST
        path /api/delivery/lease
    }
    @download {
        method GET
        path_regexp download "^/api/delivery/files/[a-f0-9]{32}$"
    }
    @ack {
        method POST
        path_regexp ack "^/api/delivery/ack/[a-f0-9]{32}$"
    }

    route {
        request_body {
            max_size 20971520
        }
        handle @dashboard {
            import machine_backend
        }
        handle @login {
            import machine_backend
        }
        handle @logout {
            import machine_backend
        }
        handle @panel_data {
            import machine_backend
        }
        handle @panel_mutate {
            import machine_backend
        }
        handle @panel_delete {
            import machine_backend
        }
        handle @health {
            import machine_backend
        }
        handle @activation {
            import machine_backend
        }
        handle @heartbeat {
            import machine_backend
        }
        handle @upload {
            import machine_backend
        }
        handle @status {
            import machine_backend
        }
        handle @lease {
            import machine_backend
        }
        handle @download {
            import machine_backend
        }
        handle @ack {
            import machine_backend
        }
        respond "Not found" 404
    }
}
