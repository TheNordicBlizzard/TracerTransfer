{
    admin off
    auto_https off
}

(machine_backend) {
    reverse_proxy 127.0.0.1:8765 {
        header_up X-Tracer-Client-IP {header.CF-Connecting-IP}
        header_up -X-Forwarded-For
        header_up -Forwarded
        header_up -CF-Connecting-IP
    }
}

http://:8766 {
    bind 127.0.0.1
    request_body {
        max_size 20971520
    }
    @dashboard path /
    handle @dashboard {
        import machine_backend
    }
    @api path /api/*
    handle @api {
        import machine_backend
    }
    @health path /health
    handle @health {
        import machine_backend
    }
    handle {
        respond "Not found" 404
    }
}
